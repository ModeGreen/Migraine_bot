# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID тех, кому можно пользоваться ботом, через запятую.
# Не знаешь свой ID — запусти бота с пустым списком и напиши ему: он ответит твоим ID.
ALLOWED_USER_IDS=

# Модель для расшифровки голосовых: tiny | base | small | medium | large-v3 | off
#   small  — быстрее и легче (~1 ГБ RAM в момент расшифровки), хуже понимает речь
#   medium — заметно точнее для русского (~2 ГБ RAM в момент расшифровки)
#   off    — не расшифровывать, только сохранять голосовые
# Модель скачивается при первом голосовом (medium ≈ 1.5 ГБ) в data/models.
WHISPER_MODEL=medium
WHISPER_LANGUAGE=ru
# Через сколько минут простоя выгружать модель из памяти
WHISPER_UNLOAD_MINUTES=10

# Через сколько минут тишины автоматически закрывать запись, если не нажали «Готово»
NOTES_AUTOCLOSE_MINUTES=60
# «Спроси позже» — через сколько минут повторить опрос
SNOOZE_MINUTES=120

# Часовой пояс. Пусто — берётся у сервера. Пример: Europe/Moscow
TZ=
